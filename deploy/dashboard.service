[Unit]
Description=Client News Dashboard + Crawler Onboarding (LAN, :8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
# Serve the news dashboard AND the "添加爬虫" onboarding form on :8080 (Flask app).
ExecStart=__APP_DIR__/venv/bin/python dashboard/server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
